# Copier ce fichier en ".env" à la racine et renseigner les vraies valeurs.
# Ne JAMAIS committer le fichier ".env" réel (voir .gitignore).

NODE_ENV="development"
PORT="3001"

DOMAIN="https://dev.union-vignerons.com"
ADMIN_DOMAIN="https://dev.union-vignerons.com"
API_BASE_ROUTE="api"
API_BASE_UPLOAD_URL="https://dev.union-vignerons.com/api/uploads"

CORS_ORIGINS="https://dev.union-vignerons.com,http://localhost:5173"

# --------------------------------------------
#               JWT
# --------------------------------------------
JWT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EXP="30d"

# --------------------------------------------
#               AUTORISATION
# --------------------------------------------
# Noms de permission (PRMNAM, cf. table PERMISSIONS) considérés comme
# "gestionnaires" pour cette application — liste séparée par des virgules.
# Même convention que VITE_MODIFY_PERMS côté front (@uvcdr/api-auth-system,
# JWTPayload.CAN_MODIFY) : une seule source de vérité sur "qui peut modifier",
# déclinée en variable d'env de chaque côté. Utilisé par
# core/middlewares/auth.middleware.js (requirePermission), ex: gestion des
# services/membres ticketing (cf. modules/ticketing/routes.js).
MODIFY_PERMS="DEV,SUPERADMIN,ADMIN"

# --------------------------------------------
#               SQL SERVER (hôte partagé)
# --------------------------------------------
DB_HOST="xxxxxxxxxxx"
DB_PORT="1433"

# --------------------------------------------
#               UPLOADS
# --------------------------------------------
UPLOAD_PATH="./uploads"
UPLOAD_TMP_PATH="./tmp"
# Rétention des fichiers temporaires non finalisés (jours) avant purge automatique
TMP_RETENTION_DAYS="7"
# Rétention (mois) des pièces jointes supprimées (DELETEDAT) avant suppression du fichier physique
ATTACHMENTS_RETENTION_MONTHS="3"
# true = journalise la purge sans rien supprimer
ATTACHMENTS_PURGE_DRY_RUN="false"

# --------------------------------------------
#               SIGNATURE NUMÉRIQUE DES PJ (HMAC)
# --------------------------------------------
# cf. core/services/attachmentSigning.service.js et
# modules/files/sql/ATTACHMENTSIGNATURES.table.sql.
# Version de clé COURANTE utilisée pour SIGNER une nouvelle pièce jointe.
# Pour faire tourner la clé : ajouter ATTACHMENT_SIGNING_SECRET_V2 ci-dessous
# SANS retirer ATTACHMENT_SIGNING_SECRET_V1 (sinon les signatures existantes
# deviennent invérifiables), puis basculer cette valeur sur "V2" une fois le
# déploiement propagé.
ATTACHMENT_SIGNING_KEY_VERSION="V1"
ATTACHMENT_SIGNING_SECRET_V1="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# --------------------------------------------
#               LOGS
# --------------------------------------------
LOG_LEVEL="debug"

# --------------------------------------------
#               DECLCAV (déclarations de cave)
# --------------------------------------------
# Destinataire de secours pour les notifications declcav (questionnaires,
# relances...) qui n'ont pas de destinataire "métier" direct. Même logique de
# repli dev que ticketing (cf. modules/ticketing/controllers.js) : hors
# production, TOUS les mails ticketing/declcav partent vers cette adresse au
# lieu des vraies adresses métier (créateur de ticket, membres de service,
# cave réelle...), pour ne jamais notifier de vrais destinataires depuis un
# environnement de dev/staging.
BASE_RECIPIENT_EMAIL="p.bayet@union-vignerons.com"

# FAQ — notifications mail aux modérateurs + profils MODIFY_PERMS (création publication/réponse,
# cf. modules/faq/notifications.js). Optionnels :
# - FAQ_APP_URL   : URL du front FAQ pour le lien du mail (défaut : ${DOMAIN}/faq)
# - FAQ_MAIL_FROM : expéditeur (défaut : EMAIL_FROM)
# - FAQ_APP_CODE  : APPCOD de l'application FAQ, pour inclure les profils
#                   MODIFY_PERMS dans les destinataires (défaut : FAQ)
# FAQ_APP_URL="https://dev.union-vignerons.com/faq"
# FAQ_MAIL_FROM="faq@union-vignerons.com"

# Audits qualité (cf. modules/declcav/audits) :
# - adresse (ou liste séparée par des virgules) notifiée quand une cave
#   retourne ses documents d'audit ;
# - services autorisés à déposer/modifier/valider/supprimer des audits
#   (comparé à payload.data.service.name ; les profils MODIFY_PERMS le sont aussi).
AUDITS_QUALITY_EMAIL="qualite@union-vignerons.com"
AUDITS_MANAGER_SERVICES="QUALITE"

# --------------------------------------------
#               TICKETING — anti-spam des notifications mail
# --------------------------------------------
# Un changement de statut ou l'ajout d'une note sur un ticket ne déclenche pas
# un email immédiat : l'envoi est différé pour regrouper les événements
# rapprochés dans le temps en un seul email (cf. modules/ticketing/controllers.js).
# Optionnelles — valeurs par défaut ci-dessous si non définies.
# Délai de silence avant envoi (ms) :
# TICKET_STATUS_MAIL_DEBOUNCE_MS="120000"
# TICKET_NOTE_MAIL_DEBOUNCE_MS="120000"
# Latence maximale depuis le 1er événement du lot, même si les événements
# continuent de s'enchaîner sans interruption (ms) :
# TICKET_STATUS_MAIL_DEBOUNCE_MAX_MS="900000"
# TICKET_NOTE_MAIL_DEBOUNCE_MAX_MS="900000"

# --------------------------------------------
#               VINIDOC (fiches œnologiques / fiches techniques)
# --------------------------------------------
# cf. modules/vinidoc/README.md. Services comparés à payload.data.service.name
# (insensible à la casse et aux accents) ; les profils MODIFY_PERMS ont
# tous les droits.
# Saisie / traduction / soumission des fiches :
VINIDOC_EDITOR_SERVICES="OENOLOGIE"
# Validation / refus (marketing) :
VINIDOC_VALIDATOR_SERVICES="MARKETING"
# Administration des modèles PowerPoint (vide = MODIFY_PERMS uniquement) :
VINIDOC_TEMPLATE_SERVICES=""
# Applications (JWT) autorisées à appeler /api/vinidoc :
# VINIDOC_APPCODES="VINDOC"
# Destinataire(s) des demandes de validation (soumission d'une fiche) :
VINIDOC_MARKETING_EMAIL="marketing@union-vignerons.com"
# Lien des mails (défaut : ${DOMAIN}/vinidoc) :
# VINIDOC_APP_URL="https://dev.union-vignerons.com/vinidoc"
# Conversion PDF : "libreoffice" (défaut) ou "powerpoint" (Windows + PowerPoint sous licence)
VINIDOC_PDF_ENGINE="libreoffice"
# Chemin complet de soffice.exe si LibreOffice n'est pas dans le PATH :
# SOFFICE_PATH="C:\Program Files\LibreOffice\program\soffice.exe"
# Conversions PDF simultanées (LibreOffice ; PowerPoint forcé à 1) et délai max (ms) :
# VINIDOC_PDF_CONCURRENCY="2"
# VINIDOC_PDF_TIMEOUT_MS="90000"
# Taille max d'un modèle .pptx (Mo) :
# VINIDOC_TEMPLATE_MAX_MB="30"

# --------------------------------------------
#               LDAP (annuaire)
# --------------------------------------------
LDAP_URL="ldap://xxxxxxxxxxxxxxx:389"
LDAP_DN="CN=xxxxxxxxxxxxxxx"
LDAP_PASSWORD="xxxxxxxxxxxxxxx"
LDAP_CA_CERT_PATH=""
SEARCH_BASE="OU=Utilisateurs,DC=UVCDR,DC=FR"

# --------------------------------------------
#               OUTLOOK / MICROSOFT GRAPH (calendrier)
# --------------------------------------------
# Service générique de création d'événements/rappels/réunions Outlook,
# commun à toutes les applis (cf. core/services/outlook.service.js).
# Nécessite un App Registration Azure AD avec la permission APPLICATION
# (pas déléguée) "Calendars.ReadWrite", consentement admin donné, sur le
# tenant Microsoft 365 de l'UVCDR (fonctionne uniquement pour des boîtes
# Exchange Online, pas Exchange on-premise).
AZURE_TENANT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
AZURE_CLIENT_ID="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
AZURE_CLIENT_SECRET="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# Boîte organisatrice utilisée quand l'appelant ne précise pas `mailbox`
# (UPN, ex: une boîte de service dédiée). Optionnel si chaque appel du
# service fournit systématiquement `mailbox`.
# OUTLOOK_DEFAULT_MAILBOX="calendrier-technique@union-vignerons.com"
# Fuseau horaire par défaut des événements créés (IANA ou nom Windows).
# OUTLOOK_DEFAULT_TIMEZONE="Romance Standard Time"

# --------------------------------------------
#               TESTS DE CHARGE (loadtest/)
# --------------------------------------------
# "true" désactive generalLimiter/authLimiter (config/rateLimit.config.js)
# pour permettre à autocannon (une seule IP) de mesurer la capacité réelle de
# l'API. Sans effet si NODE_ENV=production (garde de sécurité en dur dans le
# code). Ne JAMAIS définir dans config/env/production.env. À activer
# uniquement le temps d'une campagne de test de charge sur un environnement
# de dev/staging dédié, jamais en continu.
LOADTEST_MODE="false"

# --------------------------------------------
#               PASSWORDS — relances d'expiration des mots de passe AD
# --------------------------------------------
# Cf. modules/passwords. Hors production, tous les mails partent vers
# BASE_RECIPIENT_EMAIL (l'objet indique le vrai destinataire) et la tâche
# planifiée n'est pas lancée.
# Relance auto (jours ouvrés, prod) : "false" pour la désactiver.
# PWD_REMINDER_SCHEDULE_ENABLED="true"
# PWD_REMINDER_HOUR="8"
# PWD_REMINDER_MINUTE="0"
# Paliers (jours restants) déclenchant la relance auto.
# PWD_REMINDER_TIERS="15,7,1"
# Comptes expirés relancés chaque jour pendant N jours après l'expiration.
# PWD_REMINDER_EXPIRED_MAX_DAYS="30"
# Seuil par défaut de la relance générale manuelle.
# PWD_REMINDER_DEFAULT_DAYS="15"
# Délai minimal entre deux relances manuelles d'un même compte (minutes).
# PWD_REMINDER_COOLDOWN_MIN="10"
# Envois SMTP simultanés lors d'une relance groupée.
# PWD_REMINDER_CONCURRENCY="3"
# Applications (JWT) autorisées à déclencher une relance (+ PRMNAM ∈ MODIFY_PERMS).
# PWD_REMINDER_APPCODES="USRMAN"
# Expéditeur (défaut : EMAIL_FROM).
# PWD_REMINDER_FROM="informatique@union-vignerons.com"
# Lien du bouton "Changer mon mot de passe" (portail self-service, optionnel).
# PWD_CHANGE_URL=""
# Contacts affichés dans l'encart "Besoin d'aide ?" : "Nom|email;Nom|email".
# PWD_REMINDER_CONTACTS="Support informatique|support@union-vignerons.com"
