# Copier en config/env/development.env et renseigner les vraies valeurs.
# Ne JAMAIS committer le fichier réel (voir .gitignore).

# Identifiants SQL mutualisés (partagés par tous les modules internes,
# sauf ceux qui déclarent explicitement leur propre DB_HOST_*/DB_USER_*/DB_PASS_*)
DB_USER="xxxxxxxxxxx"
DB_PASS="xxxxxxxxxxx"

# usersmanager (lookup users/permissions pour l'authentification)
DB_APP_CODE_USERSMANAGER="USRMAN"
DB_NAME_USERSMANAGER="USERSMANAGER"

# ticketing
DB_APP_CODE_TICKETING="TCK"
DB_NAME_TICKETING="TICKETING"

# attachments (pièces jointes, lecture/écriture des métadonnées de fichiers)
DB_APP_CODE_ATTACHMENTS="FILES"
DB_NAME_ATTACHMENTS="APPATTACHMENTS"

# declcav (déclarations de cave — MRV, caves, ingrédients, questionnaires)
# NB : DB_APP_CODE_DECLCAV repris de l'ancien appCode "DCLING" utilisé par
# modules/emails en V1.0.0 — à confirmer/ajuster si besoin.
DB_APP_CODE_DECLCAV="DCLING"
DB_NAME_DECLCAV="DECLCAV"

# fsa (Fiches Suivi Affaires — dossiers commerciaux, gestionnaires, validations)
# NB : DB_APP_CODE_FSA/DB_NAME_FSA déduits de V1.0.0/config/db/fsa.db.config.js
# et modules/emails/templates/fsa (appCode "FSA" utilisé par
# emailService.send({ appCode: "FSA", ... })) — la base V1.0.0 s'appelle "FSA"
# (cf. DB_HOST_FSA/DB_USER_FSA/DB_PASS_FSA de l'ancienne config). À confirmer
# si un nom de base différent est utilisé en réalité côté SQL Server.
DB_APP_CODE_FSA="FSA"
DB_NAME_FSA="FSA"

# GENERALACTIVITY
DB_APP_CODE_GENERALACTIVITY="GENACT"
DB_NAME_GENERALACTIVITY="GENERALACTIVITY"

# faq (questions/reponses entre utilisateurs + boite a suggestions,
# base de connaissance issue des reponses validees par les moderateurs)
DB_APP_CODE_FAQ="FAQ"
DB_NAME_FAQ="FAQ"

# dwhbi (Power BI / entrepôt de données) — hôte et identifiants dédiés
# (appCode "BAS"), repris de V1.0.0/config/db/dwhbi.db.config.js.
DB_HOST_DWHBI="xxxxxxxxxxxxxxx"
DB_USER_DWHBI="xxxxxxxxxxxxxxx"
DB_PASS_DWHBI="xxxxxxxxxxxxxxx"
DB_APP_CODE_DWHBI="BAS"
DB_NAME_DWHBI="DWH_BI_2025"

# x3v12 (base Sage X3 / BackOffice) — hôte et identifiants dédiés
# (appCode "BAS"), repris de V1.0.0/config/db/x3v12.db.config.js.
DB_HOST_X3V12="xxxxxxxxxxxxxxx"
DB_USER_X3V12="xxxxxxxxxxxxxxx"
DB_PASS_X3V12="xxxxxxxxxxxxxxx"
DB_APP_CODE_X3V12="BAS"
DB_NAME_X3V12="basex3"

# vinidoc (fiches œnologiques multilingues + génération des fiches techniques
# PowerPoint/PDF) — schéma : modules/vinidoc/sql/VINIDOC.tables.sql
DB_APP_CODE_VINIDOC="VINDOC"
DB_NAME_VINIDOC="VINIDOC"
